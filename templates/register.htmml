{% extends "base.html" %}
{% block content %}

<style>
    body {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
    }

    .auth-card {
        max-width: 450px;
        margin: 80px auto;
        padding: 35px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        backdrop-filter: blur(12px);
    }

    .auth-title {
        font-weight: 800;
        text-align: center;
        margin-bottom: 25px;
        color: #198754;
        font-size: 28px;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #e0e0e0;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.2rem rgba(25,135,84,0.25);
    }

    .btn-register {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        background: linear-gradient(135deg, #198754, #20c997);
        border: none;
        font-weight: 600;
        font-size: 16px;
        transition: 0.3s;
    }

    .btn-register:hover {
        transform: scale(1.02);
        opacity: 0.95;
    }

    .auth-link {
        display: block;
        text-align: center;
        margin-top: 15px;
        text-decoration: none;
        font-weight: 500;
    }

    .icon {
        text-align: center;
        font-size: 40px;
        margin-bottom: 10px;
        color: #198754;
    }
</style>

<div class="auth-card">

    <div class="icon">🧑‍⚕️</div>

    <h2 class="auth-title">Create Account</h2>

    <form method="POST">

        <div class="mb-3">
            <label class="form-label">Username</label>
            <input name="username" class="form-control" placeholder="Enter username">
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" placeholder="Create password">
        </div>

        <button class="btn btn-success btn-register">
            Register
        </button>

    </form>

    <a href="/login" class="auth-link text-primary">
        Already have an account? Login
    </a>

</div>

{% endblock %}